# PostgreSQL
JASI_DATABASE_URL=postgresql+asyncpg://jasi:jasi@127.0.0.1:5432/jasi

# OpenAI-compatible Chat Completions endpoint
JASI_OPENAI_BASE_URL=https://api.deepseek.com/v1
JASI_OPENAI_API_KEY=your-api-key
JASI_OPENAI_MODEL=deepseek-v4-flash
JASI_MODEL_TIMEOUT_SECONDS=60

# Telegram
JASI_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Comma-separated numeric Telegram user IDs. Empty is rejected at startup.
JASI_TELEGRAM_ALLOWED_USER_IDS=123456789
JASI_TELEGRAM_POLL_TIMEOUT_SECONDS=30
JASI_TELEGRAM_MAX_CONCURRENCY=8

# Runtime
JASI_TIMEZONE=Asia/Shanghai
JASI_OUTBOX_BATCH_SIZE=20
JASI_LOG_LEVEL=INFO
