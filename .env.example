# PostgreSQL
JASI_DATABASE_URL=postgresql+asyncpg://jasi:jasi@127.0.0.1:5432/jasi

# OpenAI-compatible Chat Completions endpoint
JASI_OPENAI_BASE_URL=https://api.deepseek.com/v1
JASI_OPENAI_API_KEY=your-api-key
JASI_OPENAI_MODEL=deepseek-v4-flash
JASI_MODEL_TIMEOUT_SECONDS=60

# Lightweight OpenAI-compatible model for memory extraction, reconciliation,
# summaries, Gate, Rewrite, HyDE, Rerank, and Sufficiency. Defaults to the main
# endpoint only when all three values are omitted.
JASI_LIGHT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JASI_LIGHT_MODEL_API_KEY=your-light-model-api-key
JASI_LIGHT_MODEL=qwen-flash
JASI_LIGHT_MODEL_TIMEOUT_SECONDS=30

# Telegram
JASI_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Comma-separated numeric Telegram user IDs. Empty is rejected at startup.
JASI_TELEGRAM_ALLOWED_USER_IDS=123456789
JASI_PROMPT_DIR=prompts
# Map channel identities to a shared memory scope, for example:
# JASI_MEMORY_SCOPE_MAP={"telegram:123456789":"owner","feishu:ou_xxx":"owner"}
JASI_MEMORY_SCOPE_MAP={}
JASI_MEMORY_ROOT=workspace/memory
# Optional. Omit both endpoint and key for lexical-only retrieval.
JASI_MEMORY_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JASI_MEMORY_EMBEDDING_API_KEY=your-embedding-api-key
JASI_MEMORY_EMBEDDING_MODEL=text-embedding-v3
JASI_MEMORY_EMBEDDING_TIMEOUT_SECONDS=30
JASI_MEMORY_CONSOLIDATION_BATCH_MESSAGES=6
JASI_MEMORY_JOB_BATCH_SIZE=4
JASI_MEMORY_JOB_LEASE_SECONDS=300
JASI_MEMORY_RECONCILE_SECONDS=30
JASI_MEMORY_SEARCH_LIMIT=12
JASI_MEMORY_INJECT_LIMIT=6
JASI_MEMORY_SCORE_THRESHOLD=0.35
JASI_MEMORY_MAX_CONTEXT_CHARS=6000
JASI_TELEGRAM_POLL_TIMEOUT_SECONDS=30
JASI_TELEGRAM_MAX_CONCURRENCY=8

# Runtime
JASI_TIMEZONE=Asia/Shanghai
JASI_WORK_BATCH_SIZE=8
JASI_WORK_BACKGROUND_CONCURRENCY=2
JASI_WORK_LEASE_SECONDS=600
JASI_WORK_HEARTBEAT_SECONDS=200
JASI_SCHEDULE_BATCH_SIZE=20
JASI_SCHEDULE_POLL_SECONDS=1
JASI_SOURCE_BATCH_SIZE=10
JASI_INITIATIVE_BATCH_SIZE=10
JASI_DRIFT_BATCH_SIZE=5
JASI_EFFECT_BATCH_SIZE=20
JASI_OUTBOX_BATCH_SIZE=20
JASI_LOG_LEVEL=INFO
